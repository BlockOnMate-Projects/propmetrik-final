{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Frontend (Next.js :3000)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "cwd": "frontend"
    },
    {
      "name": "Backend API (:4000)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:tsx"],
      "port": 4000,
      "cwd": "backend"
    },
    {
      "name": "Tenant Portal (Next.js :3001)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3001,
      "cwd": "tenant-portal"
    }
  ]
}
