# PropMetrik frontend — local development
# Copy to frontend/.env.local (gitignored) and fill in values.
#
#   cp .env.example .env.local
#
# AUTH_SECRET is required — without it Auth.js throws MissingSecret on login.

# Auth.js / NextAuth (min 32 characters; generate: openssl rand -hex 32)
AUTH_SECRET=replace-with-openssl-rand-hex-32
NEXTAUTH_SECRET=replace-with-openssl-rand-hex-32
NEXTAUTH_URL=http://localhost:3000

# Backend API — server-side fetches (NextAuth login, API route proxies)
INTERNAL_API_URL=http://localhost:4000

# Browser-facing API base (Next.js rewrites /api/* to the backend)
NEXT_PUBLIC_API_URL=/api

# Optional — only if you run the Python valuation engine locally
# NEXT_PUBLIC_PYTHON_API_URL=/ml-api
