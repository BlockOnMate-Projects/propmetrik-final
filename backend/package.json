{
  "name": "@propmetrik/backend",
  "version": "1.0.0",
  "description": "PROPMETRIK Ghana - Real Estate Intelligence Platform Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bash dev.sh",
    "dev:tsx": "tsx watch --clear-screen=false src/index.ts",
    "dev:legacy": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "clean": "rm -rf dist node_modules",
    "migrate": "ts-node src/database/migrate.ts run",
    "migrate:status": "ts-node src/database/migrate.ts status",
    "migrate:rollback": "ts-node src/database/migrate.ts rollback",
    "seed": "ts-node src/database/seeds/index.ts",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:unit": "jest --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "docker:dev": "docker compose up -d api",
    "docker:local": "docker compose --profile local-db up -d",
    "docker:build": "docker build -t propmetrik-api .",
    "docs": "redocly build-docs openapi.yaml --output docs/api.html",
    "keycloak:list": "node scripts/list-clients.js",
    "keycloak:provision": "node scripts/provision-keycloak-clients.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@aws-sdk/client-s3": "^3.478.0",
    "@aws-sdk/s3-request-presigner": "^3.478.0",
    "@opensearch-project/opensearch": "^2.5.0",
    "@types/bcrypt": "^6.0.0",
    "axios": "^1.13.2",
    "axios-retry": "^4.5.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.12.0",
    "cheerio": "^1.1.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "docx": "^9.5.3",
    "docxtemplater": "^3.67.6",
    "docxtemplater-image-module-free": "^1.1.1",
    "dotenv": "^16.3.1",
    "ethers": "^6.16.0",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.3.1",
    "fast-csv": "^5.0.5",
    "google-auth-library": "^10.5.0",
    "googleapis": "^170.1.0",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.5",
    "ioredis": "^5.3.2",
    "jose": "^5.2.0",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.0",
    "keycloak-connect": "^23.0.4",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.2.1",
    "node-forge": "^1.3.3",
    "node-pg-migrate": "^6.2.2",
    "nodemailer": "^7.0.12",
    "openai": "^6.16.0",
    "pdf-lib": "^1.17.1",
    "pdfkit": "^0.17.2",
    "pg": "^8.11.3",
    "pino": "^8.17.2",
    "pino-pretty": "^10.3.1",
    "pizzip": "^3.2.0",
    "puppeteer": "^24.36.1",
    "qrcode": "^1.5.4",
    "sharp": "^0.33.5",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.12.0",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cheerio": "^0.22.35",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.6",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.5",
    "@types/pdfkit": "^0.17.4",
    "@types/pg": "^8.10.9",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "pino-http": "^9.0.0",
    "prettier": "^3.1.1",
    "rate-limiter-flexible": "^4.0.1",
    "shadcn": "^3.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "Cedyn Group",
  "license": "PROPRIETARY",
  "repository": {
    "type": "git",
    "url": "git@github.com:CedynGroup/propmetrik.git"
  }
}
