// PROPMETRIK Backend Environment Configuration
// Copy this file to .env and fill in your actual values

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
NODE_ENV=development
PORT=4000
API_VERSION=v1
APP_NAME=propmetrik
# SECURITY: unauthenticated "dev mode" login (logs in as the first super_admin)
# is now an EXPLICIT opt-in for LOCAL development only. Set this to 'true' in your
# local .env to keep the no-token dev login working. It is IGNORED in production
# (NODE_ENV=production) and when unset, so an unset NODE_ENV can no longer open
# the door. Never set this in any deployed environment.
AUTH_DEV_BYPASS=true
# Background cron/schedulers (scrapy, economic data, rent reminders, etc.).
# Defaults OFF in development — set true only when you intend to run jobs against remote infra.
RUN_BACKGROUND_JOBS=false
# Fail startup if an already-applied migration file was edited. Auto-enabled when NODE_ENV=production.
MIGRATION_STRICT_CHECKSUM=false
# Outward-facing base URLs used to build links in e-sign / invite / invoice / payment emails.
# LOCAL ONLY below. In ANY deployed environment set these to the real hosts, e.g.
#   FRONTEND_URL=https://propmetrik.com   APP_URL=https://api.propmetrik.com
# ⚠️  NEVER leave FRONTEND_URL=localhost on a server — it poisons real signing/payment
# links with localhost URLs. (The config layer now ignores a localhost FRONTEND_URL when
# NODE_ENV=production as a safety net, but set it correctly regardless.)
APP_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000

# =============================================================================
# DATABASE CONFIGURATION - PostgreSQL with PostGIS
# =============================================================================
DATABASE_URL=postgresql://propmetrik_user:your-db-password@pg.example.com:5433/propmetrik?sslmode=disable
DB_HOST=pg.example.com
DB_PORT=5433
DB_NAME=propmetrik
DB_USER=propmetrik_user
DB_PASSWORD=your-db-password
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS_URL=redis://propmgtiq_redis:your-redis-password@redis.example.com:6379
REDIS_HOST=redis.example.com
REDIS_PORT=6379
REDIS_USERNAME=propmgtiq_redis
REDIS_PASSWORD=your-redis-password
REDIS_DB_AUTH=0
REDIS_DB_CACHE=1
REDIS_DB_QUEUE=2
REDIS_DB_PUBSUB=3

# =============================================================================
# OPENSEARCH CONFIGURATION
# =============================================================================
OPENSEARCH_URL=https://opensearch.example.com
OPENSEARCH_USERNAME=propmetrik_user
OPENSEARCH_PASSWORD=your-opensearch-password
OPENSEARCH_INDEX_PREFIX=propmetrik_

# =============================================================================
# MINIO / S3 OBJECT STORAGE
# =============================================================================
MINIO_ENDPOINT=s3.example.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=your-minio-access-key
MINIO_SECRET_KEY=your-minio-secret-key
MINIO_BUCKET_PROPERTIES=propmetrik-properties
MINIO_BUCKET_DOCUMENTS=propmetrik-documents
MINIO_BUCKET_MEDIA=propmetrik-media
MINIO_BUCKET_UPLOADS=propmetrik-uploads

# =============================================================================
# CLICKHOUSE ANALYTICS DATABASE
# =============================================================================
CLICKHOUSE_URL=postgresql://propmetrik_clk_user:your-clickhouse-password@pg.example.com:5433/propmetrik_clk?sslmode=disable

# =============================================================================
# KEYCLOAK AUTHENTICATION
# =============================================================================
KEYCLOAK_URL=https://sso.propmetrik.com
# Optional: origin URL for backend->Keycloak ADMIN traffic (token + /admin/realms/*).
# Point at a non-Cloudflare origin (e.g. the Keycloak host's direct/private address)
# to bypass an edge bot-challenge on the public sso host. Falls back to KEYCLOAK_URL.
# Browser-facing issuer stays KEYCLOAK_URL, so JWT validation is unaffected.
KEYCLOAK_ADMIN_URL=
KEYCLOAK_REALM=propmetrik
KEYCLOAK_CLIENT_ID=propmetrik-api
KEYCLOAK_CLIENT_SECRET=your-api-client-secret
KEYCLOAK_TENANT_CLIENT_ID=propmetrik-tenant-portal
KEYCLOAK_TENANT_CLIENT_SECRET=your-tenant-portal-client-secret
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_SECRET=your-admin-secret
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_USERNAME=
KEYCLOAK_ADMIN_PASSWORD=
TENANT_PORTAL_URL=http://localhost:3001

# =============================================================================
# JWT CONFIGURATION (for internal tokens)
# =============================================================================
# REQUIRED in production: the app now FAILS TO START if JWT_SECRET is unset or
# shorter than 16 chars when NODE_ENV=production (a known constant secret lets
# anyone mint super_admin tokens). Generate one with:  openssl rand -hex 48
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# SECURITY: shared secret gating the Python valuation engine. The engine only
# accepts requests carrying X-Engine-Secret matching this value. Set the SAME
# value in THREE places in production: (1) the Python engine env, (2) this backend
# env (Node orchestrator), (3) the frontend server env (the /ml-api route handler).
# Leave unset only for local dev. Generate with:  openssl rand -hex 32
ENGINE_SHARED_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# =============================================================================
# FILE UPLOAD
# =============================================================================
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,xls,xlsx

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=pretty

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.propmetrik.com

# =============================================================================
# ECONOMIC DATA SOURCES
# =============================================================================
# Bank of Ghana Scraper Configuration
BOG_SCRAPER_USER_AGENT=PropMetrik Economic Data Bot/1.0
BOG_SCRAPER_TIMEOUT_MS=30000
BOG_RETRY_ATTEMPTS=3
BOG_RATE_LIMIT_MS=1500

# World Bank WDI API
WDI_API_BASE_URL=https://api.worldbank.org/v2
WDI_COUNTRY_CODE=GH
WDI_CACHE_TTL_SECONDS=86400

# Exchange Rate APIs
FOREXRATE_API_KEY=your-forexrate-api-key
FOREXRATE_API_URL=https://api.forexrateapi.com/v1
OPEN_EXCHANGE_RATES_API_KEY=
FX_CACHE_TTL_SECONDS=300
# Polygon.io / Massive forex API — real-time backstop under BoG's daily official rate.
# Free tier (5 calls/min) serves end-of-day closes, which is fine for a backstop; the
# client hard-caps at 5 calls/60s. NOTE: confirm GHS pair coverage (C:USDGHS) on your
# plan — the chain falls through to the other sources if the pair is absent.
POLYGON_FX_API_KEY=
POLYGON_FX_API_URL=https://api.polygon.io

# =============================================================================
# ECONOMIC DATA SCHEDULER
# =============================================================================
ECONOMIC_SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Africa/Accra

# BOG sync - 8 AM on 1st of each month
BOG_SYNC_CRON=0 8 1 * *

# WDI sync - Midnight on 1st of Jan, Apr, Jul, Oct
WDI_SYNC_CRON=0 0 1 */3 *

# FX cache update - Every 5 minutes
FX_UPDATE_CRON=*/5 * * * *

# FX daily persistence - 5 PM weekdays (market close)
FX_DAILY_CRON=0 17 * * 1-5

# Bank of Ghana DAILY interbank FX scrape - 9:30 AM weekdays (the official
# settlement rate; scraped from /treasury-and-the-markets/daily-interbank-fx-rates/)
BOG_FX_DAILY_CRON=30 9 * * 1-5

# =============================================================================
# MONITORING & ALERTS
# =============================================================================
# Data freshness thresholds (days)
BOG_DATA_FRESHNESS_DAYS=35
WDI_DATA_FRESHNESS_DAYS=400
FX_DATA_FRESHNESS_MINUTES=10

# Alert configuration
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=dev@propmetrik.com
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK=

# =============================================================================
# EXTERNAL APIS - MAPPING & GEOCODING
# =============================================================================
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Ghana Post GPS - Self-hosted Docker (FREE)
# Docker: docker run -d -p 8585:80 jayluxferro/ghanapostgps-api
GHANA_POST_GPS_API_URL=http://localhost:8585
GHANA_POST_GPS_FALLBACK_URL=https://ghanapostgps.sperixlabs.org/api

# =============================================================================
# WHATSAPP BUSINESS CLOUD API (Phase 5.7)
# Get credentials at: https://developers.facebook.com/
# FREE: 1,000 service conversations/month
# =============================================================================
WHATSAPP_API_VERSION=v18.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=propmetrik_webhook_2024

# =============================================================================
# GOOGLE CALENDAR API (Phase 5.7)
# Get credentials at: https://console.cloud.google.com/
# FREE: 1,000,000 queries/day
# =============================================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALENDAR_API_KEY=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# =============================================================================
# PAYMENTS - PAYSTACK (Phase 5.7)
# =============================================================================
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# =============================================================================
# E-SIGN SERVICE CONFIGURATION (Phase 7)
# =============================================================================
# E-Sign is now integrated into the Express backend via /api/v1/esign routes
# No separate service URL needed - all e-sign functionality uses the main backend
ESIGN_INTERNAL_API_KEY=your-internal-api-key-here
ESIGN_WEBHOOK_SECRET=your-webhook-hmac-secret-here
ESIGN_MAGIC_LINK_BASE_URL=http://localhost:3000/sign

# =============================================================================
# DEPRECATED / OPTIONAL APIS
# =============================================================================
# TWILIO_ACCOUNT_SID=   # Not needed - using WhatsApp Cloud API
# TWILIO_AUTH_TOKEN=    # Not needed - using WhatsApp Cloud API
# SENDGRID_API_KEY=     # Not needed - using custom SMTP

# =============================================================================
# NOWPAYMENTS — OFF-CHAIN CRYPTO PAYMENT PROCESSOR
# Handles cross-chain/non-EVM payments (BTC, ETH L1, SOL, LTC, etc.)
# Sign up: https://nowpayments.io/
# =============================================================================
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false
# Base URL for IPN callbacks (must be publicly reachable)
NOWPAYMENTS_CALLBACK_URL=https://api.propmetrik.com
# Platform wallet that receives normalized stablecoin for escrow flows
PLATFORM_SETTLEMENT_WALLET=

# =============================================================================
# SMART CONTRACTS — Polygon
# =============================================================================
# Deployed PROPMETRIKPayments contract address
PROPMETRIK_CONTRACT_ADDRESS=
PROPMETRIK_CONTRACT_CHAIN_ID=137
# Polygon RPC (Alchemy, Infura, etc.)
POLYGON_RPC_URL=
POLYGON_WS_URL=
# Admin signer key (registrar — used for registerRecipient, attestation, etc.)
CRYPTO_ADMIN_PRIVATE_KEY=
# USDT token address on Polygon
USDT_CONTRACT_ADDRESS=0xc2132D05D31c914a87C6611C10748AEb04B58e8F
# Etherscan / Polygonscan API key
ETHERSCAN_API_KEY=
