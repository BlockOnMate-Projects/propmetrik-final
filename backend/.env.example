# =============================================================================
# KEYCLOAK AUTHENTICATION
# =============================================================================
KEYCLOAK_URL=https://sso.cedynhq.com
KEYCLOAK_REALM=propmetrik
KEYCLOAK_CLIENT_ID=propmetrik-api
KEYCLOAK_CLIENT_SECRET=your-api-client-secret
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_ADMIN_SECRET=your-admin-secret

# =============================================================================
# JWT CONFIGURATION (for internal tokens)
# =============================================================================
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# =============================================================================
# FILE UPLOAD
# =============================================================================
MAX_FILE_SIZE=10485760
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,xls,xlsx

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=pretty

# =============================================================================
# CORS
# =============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://app.propmetrik.com

# =============================================================================
# ECONOMIC DATA SOURCES
# =============================================================================
# Bank of Ghana Scraper Configuration
BOG_SCRAPER_USER_AGENT=PropMetrik Economic Data Bot/1.0
BOG_SCRAPER_TIMEOUT_MS=30000
BOG_RETRY_ATTEMPTS=3
BOG_RATE_LIMIT_MS=1500

# World Bank WDI API
WDI_API_BASE_URL=https://api.worldbank.org/v2
WDI_COUNTRY_CODE=GH
WDI_CACHE_TTL_SECONDS=86400

# Exchange Rate APIs
FOREXRATE_API_KEY=e371f1d348c33fb9c92b12c6e10dbc10
FOREXRATE_API_URL=https://api.forexrateapi.com/v1
OPEN_EXCHANGE_RATES_API_KEY=
FX_CACHE_TTL_SECONDS=300

# =============================================================================
# ECONOMIC DATA SCHEDULER
# =============================================================================
ECONOMIC_SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Africa/Accra

# BOG sync - 8 AM on 1st of each month
BOG_SYNC_CRON=0 8 1 * *

# WDI sync - Midnight on 1st of Jan, Apr, Jul, Oct
WDI_SYNC_CRON=0 0 1 */3 *

# FX cache update - Every 5 minutes
FX_UPDATE_CRON=*/5 * * * *

# FX daily persistence - 5 PM weekdays (market close)
FX_DAILY_CRON=0 17 * * 1-5

# =============================================================================
# MONITORING & ALERTS
# =============================================================================
# Data freshness thresholds (days)
BOG_DATA_FRESHNESS_DAYS=35
WDI_DATA_FRESHNESS_DAYS=400
FX_DATA_FRESHNESS_MINUTES=10

# Alert configuration
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_TO=dev@propmetrik.com
ALERT_SLACK_ENABLED=false
ALERT_SLACK_WEBHOOK=

# =============================================================================
# EXTERNAL APIS - MAPPING & GEOCODING
# =============================================================================
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# Ghana Post GPS - Self-hosted Docker (FREE)
# Docker: docker run -d -p 8585:80 jayluxferro/ghanapostgps-api
GHANA_POST_GPS_API_URL=http://localhost:8585
GHANA_POST_GPS_FALLBACK_URL=https://ghanapostgps.sperixlabs.org/api

