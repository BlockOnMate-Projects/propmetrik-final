# Propmetrik Backend - .dockerignore

# Git
.git
.gitignore

# Dependencies
node_modules

# Build outputs
dist
build

# Test files
coverage
.nyc_output
*.test.ts
*.spec.ts
__tests__

# Development files
.env
.env.local
.env.development
.env.test
*.log
npm-debug.log*

# IDE
.idea
.vscode
*.swp
*.swo
.DS_Store

# Documentation (root-level only — /src/docs/ has TypeScript source)
/docs
*.md
!README.md

# Docker files (avoid recursive copying)
Dockerfile*
docker-compose*
.dockerignore

# CI/CD
.github
.gitlab-ci.yml
.travis.yml

# Misc
*.tgz
*.tar.gz
tmp
temp
