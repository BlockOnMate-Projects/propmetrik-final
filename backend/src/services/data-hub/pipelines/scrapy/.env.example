# PROPMETRIK Scrapers - Environment Configuration
#
# Copy this file to .env and fill in the values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# PostgreSQL
POSTGRES_HOST=pg.propmetrik.com
POSTGRES_PORT=5434
POSTGRES_DB=propmetrik
POSTGRES_USER=propmetrik_app
POSTGRES_PASSWORD=

# OpenSearch
OPENSEARCH_HOST=opensearch.propmetrik.com
OPENSEARCH_PORT=9200
OPENSEARCH_USER=propmetrik_api
OPENSEARCH_PASSWORD=
OPENSEARCH_INDEX=propmetrik_properties
OPENSEARCH_USE_SSL=true

# Redis
REDIS_HOST=redis.propmetrik.com
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=1

# ============================================================================
# GEOCODING
# ============================================================================

MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_API_KEY=

# ============================================================================
# PROPMETRIK API
# ============================================================================

PROPMETRIK_API_URL=http://localhost:4000
PROPMETRIK_API_KEY=

# ============================================================================
# PROXY CONFIGURATION (Optional)
# ============================================================================

PROXY_ENABLED=false
PROXY_LIST_URL=

# ============================================================================
# SPIDER SETTINGS
# ============================================================================

# Pages per run (default: 50)
MEQASA_PAGES_PER_RUN=50
GPC_PAGES_PER_RUN=50
JIJI_PAGES_PER_RUN=50

