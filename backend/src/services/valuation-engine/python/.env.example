# PROPMETRIK Python Valuation Engine Environment Configuration
# Copy to .env and update with your actual values

# Application Settings
ENVIRONMENT=development
DEBUG=true
API_VERSION=v1
SERVICE_NAME=propmetrik-valuation-engine

# Database Configuration (PostgreSQL with PostGIS)
DATABASE_URL=postgresql://propmetrik:propmetrik@localhost:5432/propmetrik
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=propmetrik
DATABASE_USER=propmetrik
DATABASE_PASSWORD=propmetrik
DATABASE_SSL_MODE=prefer

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Server Configuration
HOST=0.0.0.0
PORT=8000
WORKERS=4
LOG_LEVEL=info
ACCESS_LOG=true

# External API Configuration
# Ghana Statistical Service API
GSS_API_URL=https://api.statsghana.gov.gh
GSS_API_KEY=your-gss-api-key

# Bank of Ghana API (for exchange rates)
BOG_API_URL=https://bog.gov.gh/api
BOG_API_KEY=your-bog-api-key

# Google Maps API (for geocoding)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Security
SECRET_KEY=your-super-secure-secret-key-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
ALLOWED_HEADERS=*

# Ghana Market Configuration
DEFAULT_CURRENCY=GHS
PROPERTY_TAX_RATE=0.02
LAND_TITLE_VERIFICATION_ENABLED=true
VALUATION_CONFIDENCE_THRESHOLD=0.75

# Feature Flags
ENABLE_ML_MODELS=true
ENABLE_PRICE_PREDICTIONS=true
ENABLE_MARKET_ANALYSIS=true
ENABLE_SPATIAL_ANALYTICS=true

# Monitoring and Logging
PROMETHEUS_ENABLED=true
METRICS_PORT=9090
HEALTH_CHECK_ENDPOINT=/health
STRUCTURED_LOGGING=true

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx
UPLOAD_PATH=/app/uploads

# Caching Configuration
CACHE_TTL_SECONDS=3600
CACHE_MAX_KEYS=10000

# Development Settings
RELOAD=true
DEBUG_SQL=false
ENABLE_DOCS=true