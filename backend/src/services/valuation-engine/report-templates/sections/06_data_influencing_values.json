{
  "id": "data_influencing_values",
  "title": "Chapter Three: Data Influencing Property Values",
  "order": 6,
  "content": "<h2 style='text-align: center;'><strong>CHAPTER THREE (3)</strong></h2>\n<h3 style='text-align: center; margin-bottom: 24px;'><strong>DATA INFLUENCING PROPERTY VALUES</strong></h3>\n\n<p>&nbsp;</p>\n\n<h3 style='margin-top: 20px;'><strong>CITY DATA</strong></h3>\n<p style='margin-bottom: 20px;'>{{location.city_description}}</p>\n\n<p>&nbsp;</p>\n\n<h3 style='margin-top: 20px;'><strong>NEIGHBOURHOOD DATA</strong></h3>\n<p style='margin-bottom: 20px;'>{{location.neighborhood_description}}</p>\n\n<p>&nbsp;</p>\n\n<h3 style='margin-top: 20px;'><strong>LOCATION</strong></h3>\n<p style='margin-bottom: 20px;'>{{property.location_description}}</p>\n\n<p>&nbsp;</p>\n\n<h3 style='margin-top: 20px;'><strong>DIGITAL ADDRESS</strong></h3>\n<p style='margin-bottom: 20px;'>{{property.digital_address}}</p>\n\n<p>&nbsp;</p>\n\n<h3 style='margin-top: 20px;'><strong>BRIEF DESCRIPTION OF PROPERTY</strong></h3>\n<p style='margin-bottom: 20px;'>{{property.brief_description}}</p>\n\n<p>&nbsp;</p>\n\n<h3 style='margin-top: 20px;'><strong>GROUNDS AND EXTERNAL WORKS</strong></h3>\n<p style='margin-bottom: 20px;'>{{property.grounds_external_works}}</p>\n\n<p>&nbsp;</p>\n\n<h3 style='margin-top: 20px;'><strong>CONSTRUCTION DETAILS</strong></h3>\n<table style='width: 100%; border-collapse: collapse; margin-bottom: 20px;'>\n<tr><td style='padding: 8px; border: 1px solid #ddd; width: 150px;'><strong>Floor:</strong></td><td style='padding: 8px; border: 1px solid #ddd;'>{{property.floor_finish}}</td></tr>\n<tr><td style='padding: 8px; border: 1px solid #ddd;'><strong>Wall:</strong></td><td style='padding: 8px; border: 1px solid #ddd;'>{{property.wall_construction}}</td></tr>\n<tr><td style='padding: 8px; border: 1px solid #ddd;'><strong>Doors:</strong></td><td style='padding: 8px; border: 1px solid #ddd;'>{{property.doors}}</td></tr>\n<tr><td style='padding: 8px; border: 1px solid #ddd;'><strong>Windows:</strong></td><td style='padding: 8px; border: 1px solid #ddd;'>{{property.windows}}</td></tr>\n<tr><td style='padding: 8px; border: 1px solid #ddd;'><strong>Ceiling:</strong></td><td style='padding: 8px; border: 1px solid #ddd;'>{{property.ceiling}}</td></tr>\n<tr><td style='padding: 8px; border: 1px solid #ddd;'><strong>Roof:</strong></td><td style='padding: 8px; border: 1px solid #ddd;'>{{property.roofing}}</td></tr>\n</table>\n\n<p>&nbsp;</p>\n\n<h3 style='margin-top: 20px;'><strong>FIXTURES AND FITTINGS</strong></h3>\n<p style='margin-bottom: 20px;'>{{property.fixtures_fittings}}</p>\n\n<p>&nbsp;</p>\n\n<h3 style='margin-top: 20px;'><strong>DRAINAGE / SANITATION</strong></h3>\n<p style='margin-bottom: 20px;'>{{property.drainage_sanitation}}</p>\n\n<p>&nbsp;</p>\n\n<h3 style='margin-top: 20px;'><strong>GENERAL CONDITION AND STATE OF REPAIR</strong></h3>\n<p style='margin-bottom: 20px;'>{{property.condition_state}}</p>\n\n<p>&nbsp;</p>\n\n<h3 style='margin-top: 20px;'><strong>SERVICES</strong></h3>\n<p style='margin-bottom: 20px;'>{{property.services_description}}</p>\n\n<p>&nbsp;</p>\n\n<h3 style='margin-top: 20px;'><strong>ACCOMMODATION</strong></h3>\n<p style='margin-bottom: 20px;'>{{property.accommodation_description}}</p>\n\n<p>&nbsp;</p>\n\n<h3 style='margin-top: 20px;'><strong>EVIDENCE OF LAND VALUES</strong></h3>\n<p style='margin-bottom: 20px;'>{{property.land_value_evidence}}</p>"
}
