{
  "id": "cover_page",
  "title": "Cover Page",
  "order": 0,
  "content": "<div style='min-height:1000px;background:{{brand.primary_color}};color:{{brand.on_primary}};padding:64px;display:flex;flex-direction:column;position:relative;overflow:hidden;'><div style='position:absolute;top:0;left:0;right:0;bottom:0;opacity:0.16;background-image:url(\"data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.4'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E\");background-repeat:repeat;'></div><div style='position:absolute;top:0;left:0;right:0;height:4px;background:{{brand.accent_color}};'></div><div style='position:relative;z-index:1;display:flex;justify-content:space-between;align-items:flex-start;'><div style='display:flex;align-items:center;gap:12px;'>{{#if brand.logo_url}}<img src='{{brand.logo_url}}' alt='{{brand.name}}' style='max-height:52px;max-width:220px;display:block;' />{{else}}<div style='width:48px;height:48px;background:{{brand.accent_color}};border-radius:10px;display:flex;align-items:center;justify-content:center;'><span style='font-size:28px;font-weight:900;color:{{brand.on_accent}};'>{{brand.initial}}</span></div><div><div style='font-size:20px;font-weight:900;color:{{brand.on_primary}};letter-spacing:-0.5px;'>{{brand.name}}</div><div style='font-size:10px;font-family:monospace;color:#a1a1aa;text-transform:uppercase;letter-spacing:3px;'>{{brand.tagline}}</div></div>{{/if}}</div><div style='text-align:right;'><div style='font-size:9px;font-family:monospace;color:#71717a;text-transform:uppercase;'>Document Date</div><div style='font-size:14px;font-weight:700;color:{{brand.on_primary}};'>{{valuation.report_date}}</div></div></div><div style='position:relative;z-index:1;flex:1;display:flex;flex-direction:column;justify-content:center;margin-top:-40px;'><div style='border-left:4px solid {{brand.accent_color}};padding-left:32px;margin-bottom:32px;'><p style='color:{{brand.accent_color}};font-family:monospace;font-size:12px;text-transform:uppercase;letter-spacing:4px;margin:0 0 16px 0;'>Valuation</p><h1 style='font-size:58px;font-weight:900;color:{{brand.on_primary}};line-height:0.98;margin:0 0 12px 0;'>{{property.address_uppercase}}<br/>{{property.city_uppercase}}, {{property.region_uppercase}}</h1><p style='font-size:20px;color:#a1a1aa;font-weight:300;margin:0;'>Valuation Report<br/><span style='color:{{brand.accent_color}};font-weight:700;'>{{valuation.effective_date_month_year}}</span></p></div><div style='display:grid;grid-template-columns:repeat(2,1fr);gap:24px;margin-top:36px;'><div style='background:rgba(255,255,255,0.05);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.10);border-radius:12px;padding:24px;'><p style='font-size:10px;font-family:monospace;color:#71717a;text-transform:uppercase;margin:0 0 8px 0;'>Market Value</p><p style='font-size:30px;font-weight:900;color:{{brand.on_primary}};margin:0;'>{{valuation.final_value_formatted}}</p></div><div style='background:rgba(255,255,255,0.05);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.10);border-radius:12px;padding:24px;'><p style='font-size:10px;font-family:monospace;color:#71717a;text-transform:uppercase;margin:0 0 8px 0;'>Land Area</p><p style='font-size:30px;font-weight:900;color:{{brand.on_primary}};margin:0;'>{{property.land_area_sqm}} m²</p></div><div style='background:rgba(255,255,255,0.05);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.10);border-radius:12px;padding:24px;'><p style='font-size:10px;font-family:monospace;color:#71717a;text-transform:uppercase;margin:0 0 8px 0;'>Prepared For</p><p style='font-size:30px;font-weight:900;color:{{brand.on_primary}};margin:0;'>{{client.name}}</p></div><div style='background:rgba(255,255,255,0.05);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.10);border-radius:12px;padding:24px;'><p style='font-size:10px;font-family:monospace;color:#71717a;text-transform:uppercase;margin:0 0 8px 0;'>Certified By</p><p style='font-size:30px;font-weight:900;color:{{brand.on_primary}};margin:0;'>{{valuer.name}}</p></div></div></div><div style='position:relative;z-index:1;display:flex;justify-content:space-between;align-items:flex-end;margin-top:auto;'><div><p style='font-size:9px;font-family:monospace;color:#52525b;text-transform:uppercase;letter-spacing:2px;margin:0 0 6px 0;'>Generated via PROPMETRIK</p><p style='font-size:9px;font-family:monospace;color:#52525b;margin:0;'>Visit propmetrik.com/services</p></div><div style='padding:12px;background:#fff;border-radius:10px;'><img src='{{brand.services_qr}}' alt='PROPMETRIK services QR' style='width:64px;height:64px;display:block;' /></div></div></div>"
}
