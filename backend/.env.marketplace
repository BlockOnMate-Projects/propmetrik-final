# Backend Environment Variables for Marketplace

# Mapbox API (Required for geocoding and location services)
MAPBOX_ACCESS_TOKEN=your_mapbox_public_token_here

# Rate limiting for marketplace endpoints
MARKETPLACE_RATE_LIMIT_PER_MINUTE=100

# OpenSearch (Optional - marketplace defaults to PostgreSQL search)
OPENSEARCH_NODE=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=admin

# Email alerts for saved searches (Future feature)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
